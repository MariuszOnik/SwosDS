<!--
  Standalone console harness that compiles OpenSWOS's ACTUAL, unmodified
  SwosVm source files (referenced from ../../../openswos, never copied) and
  runs the real Memory.Init(pcMode) to produce a byte exact "golden" dump of
  the 0x60000 byte memory buffer. This is the strongest verification
  available for the mechanical C port: a real run of the source being
  ported, not another restatement of it.

  These SwosVm files have no Godot dependency (confirmed 2026-09-15,
  grepped for using Godot / GD. / Node, zero hits), so a plain console app
  is enough; no Godot/game engine install needed.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>golden-dump</AssemblyName>
    <!-- Keep this tool's own compiler warnings quiet, it's a throwaway
         harness, not part of the port. -->
    <NoWarn>CS8618;CS8500</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real OpenSWOS source, referenced in place. -->
    <Compile Include="../../../openswos/game/scripts/SwosVm/Memory.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/Flags.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/Rng.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/Tables.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/BallSprite.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/PlayerSprite.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/TeamData.cs" />
    <Compile Include="../../../openswos/game/scripts/SwosVm/AnimationTablesData.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/SpriteUpdate.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/BallUpdate.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/BallOutOfPlay.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerActions.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerEnergy.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerUpdate.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerControlled.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/TeamPort.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/BallVariables.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerHeader.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerTackle.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/UpdatePlayers.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/InputControls.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/AiHelpers.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/AiBrain.cs" />
    <!-- Step 10: SetPieces.cs, GameTime.cs, Referee.cs, Result.cs, and the
         real UpdateGoals.cs (superseding UpdateGoalsStub.cs, whose own
         header said to delete it once Result.cs/GameTime.cs land). -->
    <Compile Include="../../../openswos/game/scripts/Sim/Port/SetPieces.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/GameTime.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Referee.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Result.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/UpdateGoals.cs" />
    <!-- Step 11 (GameLoop.cs's real local dependencies): Kickoff.cs,
         Camera.cs, GameSprites.cs, SpinningLogo.cs, PlayerNameDisplay.cs,
         Stats.cs. Bench.cs (1868 lines) stays a minimal BenchStub.cs
         (InBench/InBenchMenus/GetBenchState only) until its own dedicated
         port; GameLoop.cs's UpdateBench/CheckIfGoalkeeperClaimedTheBall
         reach almost the entire file and are not a minimal-slice candidate. -->
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Kickoff.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Camera.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/GameSprites.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/SpinningLogo.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/PlayerNameDisplay.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Stats.cs" />
    <!-- Bench.cs (full port, superseding BenchStub.cs; see
         swos-vm-c/include/swos_bench.h for the full scope note). -->
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Bench.cs" />
    <!-- GameLoop.cs (step 11B, full port, superseding GameLoopStub.cs; the
         per-tick orchestrator itself, now that every real dependency it
         reaches has landed). -->
    <Compile Include="../../../openswos/game/scripts/Sim/Port/GameLoop.cs" />
    <!-- Phase 1 bootstrap-completeness follow-up (2026-09-16): TacticsLoader.cs
         (only LoadAllTactics() is ported to C, see swos_tactics_loader.h,
         but the whole file compiles fine here, self-contained, no stub
         needed). -->
    <Compile Include="../../../openswos/game/scripts/Sim/Port/TacticsLoader.cs" />
    <!-- Phase 1 bootstrap-completeness follow-up (2026-09-16, continued):
         Pitch.cs, SkillScaling.cs (WritePlayerInfos's real dependency,
         enabled by default), TeamDataLoader.cs (the real loader, replacing
         the old hand-poked PlayerInfo bytes), Bench.cs is already included
         above (step 11). TeamRecord/PlayerRecord (Assets/) are plain data
         types, no Compile entry needed (auto-included by the SDK glob). -->
    <Compile Include="../../../openswos/game/scripts/Sim/Port/Pitch.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/SkillScaling.cs" />
    <Compile Include="../../../openswos/game/scripts/Sim/Port/TeamDataLoader.cs" />
    <!-- TeamRecord/PlayerRecord: plain data types WritePlayerInfos,
         WireTeamFields and SkillScaling consume, outside the project's own
         directory tree so the SDK's default glob doesn't reach it. -->
    <Compile Include="../../../openswos/game/scripts/Assets/TeamRecord.cs" />
    <!-- MatchAudioStub.cs, TeamDataLoaderStub.cs, PlayerControlledStub.cs,
         GodotStub.cs, AiStub.cs, BallSimStub.cs (this directory) are
         auto-included by the SDK; see each one's header comment for why
         BallUpdate.cs/BallOutOfPlay.cs/SpriteUpdate.cs/PlayerActions.cs/
         PlayerUpdate.cs/PlayerTackle.cs/UpdatePlayers.cs/GameTime.cs need a
         stand-in for those specific types rather than their real (larger,
         Godot-dependent, or deliberately-deferred) source files. -->
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PlayerControlledStub.cs" />
    <!-- UpdatePlayers.cs (added above, step 7B) now provides the real
         PortPlayerState enum, so the step-5.5 stand-in would collide. -->
    <Compile Remove="PortPlayerStateStub.cs" />
    <!-- AiHelpers.cs/AiBrain.cs (added above, step 9) now provide the real
         AiBrain/AiHelpers classes, so the step-6A throw-stub would collide. -->
    <Compile Remove="AiStub.cs" />
    <!-- TeamDataLoader.cs (added above, Phase 1 bootstrap follow-up) now
         provides the real TeamDataLoader class, so the step-5 stand-in
         would collide. -->
    <Compile Remove="TeamDataLoaderStub.cs" />
  </ItemGroup>

</Project>
